# Local development only. Keep real credentials in backend/.env or the host secret manager.
MODEL_API_KEY=
LLM_PROVIDER=meta
META_MODEL_ID=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1
GEMINI_API_KEY=
GEMINI_MODEL_ID=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ALLOW_DEV_PROVIDER=false
META_API_TIMEOUT=120
META_MAX_RETRIES=3
DATABASE_URL=sqlite:///./database/patchpilot.db
APP_ENV=development
APP_MODE=local
DEMO_MODE=false
EXECUTION_BACKEND=none
ENABLE_UPLOAD=true
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://patchpilot-delta.vercel.app
MAX_REPAIR_ATTEMPTS=3
MAX_UPLOAD_SIZE_MB=50
PUBLIC_DAILY_META_CALL_CAP=200
PUBLIC_MAX_ATTEMPTS=3
PUBLIC_MAX_TOKENS_PER_CALL=2048
PUBLIC_DEMO_ENABLED=false
PUBLIC_AI_ENABLED=false
